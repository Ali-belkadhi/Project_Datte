{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "chai"]
  },
  "include": [
    "./hardhat.config.ts",
    "./test/**/*.ts",
    "./scripts/**/*.ts",
    "./types/**/*.ts"
  ]
}
