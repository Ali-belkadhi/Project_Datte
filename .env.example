# DEGLA — variables d'environnement
# ---------------------------------------------------------------------------
# Le template fonctionne SANS aucune variable : rien n'est obligatoire.
# Toutes les variables ci-dessous sont NON UTILISÉES dans le template.
# Elles documentent ce que chaque module branchera plus tard.
# Copiez ce fichier en .env.local le moment venu.
# ---------------------------------------------------------------------------

# Commun — latence simulée des repositories mock (ms). Défaut : 300.
# MOCK_LATENCY=300

# Commun — base de données PostgreSQL (Prisma) — non utilisée dans le template
# DATABASE_URL="postgresql://degla:degla@localhost:5432/degla"

# Module A — Auth.js — non utilisée dans le template
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Module A — e-mail (Resend) et SMS (OTP) — non utilisées dans le template
# RESEND_API_KEY=
# SMS_API_KEY=

# Commun — stockage Cloudflare R2 — non utilisées dans le template
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Module B — Meshy (génération 3D) — non utilisées dans le template
# MESHY_API_KEY=
# MESHY_WEBHOOK_SECRET=

# Module C — Konnect / Flouci (stubs, non branchés : Stripe est utilisé)
# KONNECT_API_KEY=
# KONNECT_WALLET_ID=
# FLOUCI_APP_TOKEN=
# FLOUCI_APP_SECRET=

# Commun — IA générative (Vercel AI SDK) — non utilisée dans le template
# AI_MODEL="anthropic/claude-sonnet-5-5"
# AI_GATEWAY_API_KEY=

# Cron (Vercel) — non utilisée dans le template
# CRON_SECRET=


# ---------------------------------------------------------------------------
# Module C — UTILISÉES (copier dans .env.local avec vos valeurs)
# ---------------------------------------------------------------------------
# Base MongoDB (commandes, paiements, panier...). Défaut : base locale degla
MONGODB_URI="mongodb://localhost:27017/degla"
# Données de démonstration chargées au premier lancement (false pour les désactiver)
# MONGODB_DEMO=true

# Stripe — clés du tableau de bord Stripe (Développeurs > Clés API)
NEXT_PUBLIC_STRIPE_CLE_PUBLIQUE="pk_test_..."
STRIPE_CLE_SECRETE="sk_test_..."
# Secret du webhook : affiché par « stripe listen » (whsec_...) ou par le tableau de bord
STRIPE_SECRET_WEBHOOK="whsec_..."
# Stripe ne gère pas le dinar : devise de débit et taux de conversion TND -> devise
# STRIPE_DEVISE=eur
# STRIPE_TAUX_TND=0.3
# URL publique du site (retours Stripe). Défaut : http://localhost:3000
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Secret du cron des versements (Vercel Cron)
# CRON_SECRET=
