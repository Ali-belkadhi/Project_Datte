# Database shared by the account and catalogue modules
MONGODB_URI=mongodb://127.0.0.1:27017/degla
APP_URL=http://localhost:3000

# Auth.js
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email / OTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI document analysis
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# 3D generation
HF_TOKEN=
TRELLIS_SPACE=trellis-community/TRELLIS
MESHY_API_KEY=
MESHY_WEBHOOK_SECRET=
CRON_SECRET=

# Optional payment and storage integrations
KONNECT_API_KEY=
FLOUCI_APP_TOKEN=
RESEND_API_KEY=
SMS_API_KEY=
R2_BUCKET=

# Blockchain traceability (public values only - never add a private key)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
NEXT_PUBLIC_BLOCKCHAIN_CHAIN_ID=1337
NEXT_PUBLIC_DATE_TRACEABILITY_ADDRESS=
NEXT_PUBLIC_PRODUCT_CERTIFICATION_ADDRESS=

# Module C — assistant d'achat IA-C (Vercel AI SDK, configuration dans src/lib/ai.ts)
# Gemini direct (gratuit, 5 requêtes/min) ou, à défaut, OpenRouter (clé ci-dessus)
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-3.5-flash

# Module C — paiement par carte (Stripe, mode test)
NEXT_PUBLIC_STRIPE_CLE_PUBLIQUE=
STRIPE_CLE_SECRETE=
# secret affiché par « stripe listen --forward-to localhost:3000/api/webhooks/paiement »
STRIPE_SECRET_WEBHOOK=
# Stripe ne gère pas le dinar : devise de débit et taux TND → devise
# STRIPE_DEVISE=eur
# STRIPE_TAUX_TND=0.3
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Données de démonstration des commandes (false pour les désactiver)
# MONGODB_DEMO=true
