# DEGLA : copier ce fichier en .env.local puis renseigner les valeurs.

# Module B (catalogue) : base MongoDB (même base que degla-module-b pour conserver les produits).
MONGODB_URI=mongodb://127.0.0.1:27017/degla

# Génération 3D image -> GLB via le Space Hugging Face TRELLIS (GPU distant, aucun GPU local requis).
# Le token est optionnel mais augmente fortement le quota gratuit : https://huggingface.co/settings/tokens
HF_TOKEN=
TRELLIS_SPACE=trellis-community/TRELLIS
