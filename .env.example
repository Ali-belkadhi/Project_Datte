# Copy this file to .env.local and fill in your actual values

# MongoDB Connection
MONGODB_URI=

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend Email API
RESEND_API_KEY=

# Gmail SMTP (alternative à Resend — codes OTP et emails transactionnels)
# Mot de passe d'application Gmail (compte Google > Sécurité > Mots de passe des applications)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# SMS Provider
SMS_API_KEY=
SMS_API_URL=

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# AI Model Configuration (IA-A pré-contrôle documentaire)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Meshy API (Module B)
MESHY_API_KEY=

# Payment Provider (Module C)
KONNECT_API_KEY=
FLOUCI_API_KEY=

# Storage (Module B)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Environment
NODE_ENV=development
